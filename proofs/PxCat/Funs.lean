                         ok (some r)
    | sprite.Cell.Nose => let r ← coat.rgb 14259074#u32
                          ok (some r)
    | sprite.Cell.Closed => let r ← coat.rgb 2827294#u32
                            ok (some r)
  | coat.Coat.Mike =>
    match cell with
    | sprite.Cell.Empty => ok none
    | sprite.Cell.Fur =>
      let p ← coat.mike_patch x y
      match p with
      | coat.Patch.White => let r ← coat.rgb 16250094#u32
                            ok (some r)
      | coat.Patch.Orange => let r ← coat.rgb 14256701#u32
                             ok (some r)
      | coat.Patch.Black => let r ← coat.rgb 2827296#u32
                            ok (some r)
    | sprite.Cell.Stripe => let r ← coat.rgb 2827296#u32
                            ok (some r)
    | sprite.Cell.White => let r ← coat.rgb 16250094#u32
                           ok (some r)
    | sprite.Cell.Eye => let r ← coat.rgb 9412156#u32
                         ok (some r)
    | sprite.Cell.Nose => let r ← coat.rgb 15245472#u32
                          ok (some r)
    | sprite.Cell.Closed => let r ← coat.rgb 3813418#u32
                            ok (some r)
  | coat.Coat.Chatora =>
    match cell with
    | sprite.Cell.Empty => ok none
    | sprite.Cell.Fur => let r ← coat.rgb 14191173#u32
                         ok (some r)
    | sprite.Cell.Stripe => let r ← coat.rgb 11034410#u32
                            ok (some r)
    | sprite.Cell.White => let r ← coat.rgb 16183268#u32
                           ok (some r)
    | sprite.Cell.Eye => let r ← coat.rgb 10268746#u32
                         ok (some r)
    | sprite.Cell.Nose => let r ← coat.rgb 14916236#u32
                          ok (some r)
    | sprite.Cell.Closed => let r ← coat.rgb 7028511#u32
                            ok (some r)
  | coat.Coat.Shiro =>
