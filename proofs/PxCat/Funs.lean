def coat.paint
  (fur : coat.Coat) (cell : sprite.Cell) (x : Std.Usize) (y : Std.Usize) :
  Result (Option coat.Rgb)
  := do
  match fur with
  | coat.Coat.Kuro =>
    match cell with
    | sprite.Cell.Empty => ok none
    | sprite.Cell.Fur => let r ← coat.rgb 2170138#u32
                         ok (some r)
    | sprite.Cell.Stripe => let r ← coat.rgb 3025189#u32
                            ok (some r)
    | sprite.Cell.White => let r ← coat.rgb 15986922#u32
                           ok (some r)
    | sprite.Cell.Eye => let r ← coat.rgb 15320138#u32
                         ok (some r)
    | sprite.Cell.Nose => let r ← coat.rgb 14257549#u32
                          ok (some r)
    | sprite.Cell.Closed => let r ← coat.rgb 5919307#u32
                            ok (some r)
  | coat.Coat.Kiji =>
    match cell with
    | sprite.Cell.Empty => ok none
    | sprite.Cell.Fur => let r ← coat.rgb 9075046#u32
                         ok (some r)
    | sprite.Cell.Stripe => let r ← coat.rgb 4602930#u32
                            ok (some r)
    | sprite.Cell.White => let r ← coat.rgb 16184301#u32
                           ok (some r)
