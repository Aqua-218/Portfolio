/-- [pxcat_core::coat::mike_patch]:
    Source: 'crates/pxcat-core/src/coat.rs', lines 53:0-64:1
    Visibility: public -/
def coat.mike_patch (x : Std.Usize) (y : Std.Usize) : Result coat.Patch := do
  let i ← x + 1#usize
  let col ← i / 2#usize
  let i1 ← y + 1#usize
  let row ← i1 / 2#usize
  let i2 ← col * 13#usize
  let i3 ← row * 7#usize
  let i4 ← i2 + i3
  let i5 ← col * row
  let i6 ← i5 * 3#usize
  let i7 ← i4 + i6
  let seed ← i7 % 7#usize
  if seed < 2#usize
  then ok coat.Patch.Orange
  else if seed = 2#usize
       then ok coat.Patch.Black
       else ok coat.Patch.White

